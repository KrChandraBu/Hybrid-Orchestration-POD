        <mxCell id="e42" edge="1" parent="1" source="c30" target="c31" style="fontFamily=Segoe UI;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1F2937;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=7;fontSize=11;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c43" parent="1" style="fontFamily=Segoe UI;shape=ellipse;perimeter=ellipsePerimeter;whiteSpace=wrap;html=1;fillColor=#C0392B;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;fontStyle=1;" value="F1" vertex="1"><mxGeometry x="250" y="588" width="30" height="30" as="geometry" /></mxCell>
        <mxCell id="c44" parent="1" style="fontFamily=Segoe UI;shape=ellipse;perimeter=ellipsePerimeter;whiteSpace=wrap;html=1;fillColor=#C0392B;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;fontStyle=1;" value="F2" vertex="1"><mxGeometry x="560" y="612" width="30" height="30" as="geometry" /></mxCell>
        <mxCell id="c45" parent="1" style="fontFamily=Segoe UI;shape=ellipse;perimeter=ellipsePerimeter;whiteSpace=wrap;html=1;fillColor=#C0392B;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;fontStyle=1;" value="F3" vertex="1"><mxGeometry x="560" y="712" width="30" height="30" as="geometry" /></mxCell>
        <mxCell id="c46" parent="1" style="fontFamily=Segoe UI;shape=ellipse;perimeter=ellipsePerimeter;whiteSpace=wrap;html=1;fillColor=#C0392B;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;fontStyle=1;" value="F4" vertex="1"><mxGeometry x="920" y="612" width="30" height="30" as="geometry" /></mxCell>
        <mxCell id="c47" parent="1" style="fontFamily=Segoe UI;shape=ellipse;perimeter=ellipsePerimeter;whiteSpace=wrap;html=1;fillColor=#C0392B;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;fontStyle=1;" value="F5" vertex="1"><mxGeometry x="920" y="712" width="30" height="30" as="geometry" /></mxCell>
        <mxCell id="c48" parent="1" style="fontFamily=Segoe UI;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#C0392B;dashed=1;dashPattern=6 3;align=left;spacingLeft=12;spacingRight=10;fontSize=12;fontColor=#1F2937;" value="&lt;b style=&quot;color:#C0392B&quot;&gt;⚠ Message deleted on receive&lt;/b&gt;&lt;br&gt;RECEIVEANDDELETE removes the message before sendevent succeeds. If the successor job fails, the message is not redelivered — the event is lost." vertex="1"><mxGeometry x="330" y="752" width="610" height="50" as="geometry" /></mxCell>
        <mxCell id="c49" parent="1" style="fontFamily=Segoe UI;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#C0392B;dashed=1;dashPattern=6 3;align=left;spacingLeft=12;spacingRight=10;fontSize=12;fontColor=#1F2937;" value="&lt;b style=&quot;color:#C0392B&quot;&gt;⚠ Logic split across two jobs&lt;/b&gt;&lt;br&gt;No single acknowledge / retry point, and the audit row ADR 0001 needs is written outside the receive step." vertex="1"><mxGeometry x="1000" y="752" width="610" height="50" as="geometry" /></mxCell>
        <mxCell id="c50" parent="1" style="fontFamily=Segoe UI;rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=18;spacingTop=10;spacingRight=14;fontSize=13;fontColor=#1F2937;strokeColor=none;fillColor=#EEF7EF;" value="&lt;div style=&quot;font-size:16px;font-weight:bold;margin-bottom:6px&quot;&gt;Why the listener is primary&lt;/div&gt;&lt;ul style=&quot;margin:0;padding-left:18px;line-height:1.45&quot;&gt;&lt;li&gt;Reads Event Hub and DESP directly — no extra broker hop&lt;/li&gt;&lt;li&gt;Acknowledges only after sendevent succeeds&lt;/li&gt;&lt;li&gt;Writes the listener audit row correlation depends on (ADR 0001)&lt;/li&gt;&lt;li&gt;Event-driven, so no polling latency&lt;/li&gt;&lt;/ul&gt;" vertex="1"><mxGeometry x="46" y="840" width="494" height="170" as="geometry" /></mxCell>
        <mxCell id="c51" parent="1" style="fontFamily=Segoe UI;rounded=0;html=1;strokeColor=none;fillColor=#3F8F4F;" value="" vertex="1"><mxGeometry x="40" y="840" width="6" height="170" as="geometry" /></mxCell>
        <mxCell id="c52" parent="1" style="fontFamily=Segoe UI;rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=18;spacingTop=10;spacingRight=14;fontSize=13;fontColor=#1F2937;strokeColor=none;fillColor=#FBEFEE;" value="&lt;div style=&quot;font-size:16px;font-weight:bold;margin-bottom:6px&quot;&gt;Plugin fit gaps (per Automation Hub, deck slide 5)&lt;/div&gt;&lt;ul style=&quot;margin:0;padding-left:18px;line-height:1.45&quot;&gt;&lt;li&gt;&lt;b&gt;F1&lt;/b&gt; Reads Service Bus only; our source is Event Hub / DESP&lt;/li&gt;&lt;li&gt;&lt;b&gt;F2&lt;/b&gt; Job-based polling; not documented as an always-on listener&lt;/li&gt;&lt;li&gt;&lt;b&gt;F3&lt;/b&gt; RECEIVEANDDELETE: no redelivery on downstream failure&lt;/li&gt;&lt;li&gt;&lt;b&gt;F4&lt;/b&gt; No parse step and no sendevent operation&lt;/li&gt;&lt;li&gt;&lt;b&gt;F5&lt;/b&gt; Receive and process split across two jobs&lt;/li&gt;&lt;/ul&gt;" vertex="1"><mxGeometry x="576" y="840" width="534" height="170" as="geometry" /></mxCell>

        <mxCell id="c23" parent="1" style="fontFamily=Segoe UI;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF6EC;strokeColor=#3F8F4F;dashed=1;dashPattern=6 3;align=left;spacingLeft=12;spacingRight=10;fontSize=12;fontColor=#1F2937;" value="&lt;b style=&quot;color:#3F8F4F&quot;&gt;✓ One control point&lt;/b&gt;&lt;br&gt;receive → process → sendevent → acknowledge / retry in one component.&lt;br&gt;A failed sendevent leaves the event unacknowledged, so it is retried, not lost." vertex="1"><mxGeometry x="650" y="300" width="520" height="62" as="geometry" /></mxCell>

        <mxCell id="c1" parent="1" style="fontFamily=Segoe UI;text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontColor=#1F2937;" value="&lt;span style=&quot;font-size:30px;color:#2F6DB5&quot;&gt;&lt;b&gt;ADR 0002&lt;/b&gt; – Event intake: Python listener vs. TWS Azure Service Bus job plugin&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#6B7280&quot;&gt;Both paths must end in &lt;i&gt;sendevent&lt;/i&gt; to the TWS Event Processing Server. The plugin replaces only the receive step; the parsing, sendevent and audit logic stays custom.&lt;/span&gt;" vertex="1"><mxGeometry x="40" y="20" width="1580" height="80" as="geometry" /></mxCell>
        <mxCell id="c2" parent="1" style="fontFamily=Segoe UI;rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=12;fontStyle=1;fillColor=#F1F8F1;strokeColor=#3F8F4F;" value="&lt;font color=&quot;#3F8F4F&quot;&gt;OPTION A · PRIMARY — CUSTOM PYTHON TWS EVENT LISTENER (ALWAYS-ON, EVENT-DRIVEN)&lt;/font&gt;" vertex="1"><mxGeometry x="40" y="120" width="1580" height="270" as="geometry" /></mxCell>
